    { "path": "/tmp/installer.dmg", "note": "可能的中间落盘 DMG" },
    { "path": "/private/tmp/installer.dmg", "note": "可能的中间落盘 DMG（真实路径）" }
  ],
  "path_globs": [
    "/tmp/installer*",
