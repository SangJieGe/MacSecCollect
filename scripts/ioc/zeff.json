    { "path": "/private/tmp/installer", "note": "/tmp 的真实路径（macOS 上 /tmp → /private/tmp）" },
    { "path": "/Volumes/Zeff/Installer.file", "note": "挂载卷内的安装器包装脚本" },
    { "path": "/Volumes/Zeff/.back/installer", "note": "挂载卷内隐藏备份目录中的真实载荷" },
